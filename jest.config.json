{
    "preset": "ts-jest",
    "setupFiles": [
        "<rootDir>/tests/setup.ts"
    ],
    "transform": {
        "^.+\\.ts?$": "ts-jest"
    },
    "testEnvironment": "node",
    "testRegex": "/tests/.*\\.(test|spec)?\\.(ts|tsx)$",
    "moduleFileExtensions": [
        "ts",
        "js",
        "json",
        "tsx",
        "jsx",
        "node"
    ]
}